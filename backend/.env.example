# ==============================================================================
# The Project — Backend Production Environment Variables
# Copy to .env in backend/ or populate in your hosting provider (Render, Railway, AWS, GCP)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=generate-a-secure-random-64-character-hex-string-for-session-signing
API_KEY_ADMIN=generate-a-secure-random-32-character-admin-key-for-admin-portal
FRONTEND_URL=https://theproject.edu.in

# ------------------------------------------------------------------------------
# 2. DATABASE & REDIS (PostgreSQL 15+ and Redis 7+)
# ------------------------------------------------------------------------------
# Async connection string for SQLAlchemy + asyncpg
DATABASE_URL=postgresql+asyncpg://user:password@db.provider.com:5432/theproject_prod?ssl=require

# Synchronous connection string for migrations, scripts, and seeds
DATABASE_URL_SYNC=postgresql://user:password@db.provider.com:5432/theproject_prod?ssl=require

# Redis URL (e.g. Upstash Redis, Redis Cloud, or managed Redis)
REDIS_URL=rediss://default:password@redis.provider.com:6379/0

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & OAUTH 2.0 (Google Cloud Console)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://theproject.edu.in/api/auth/callback/google

# JWT Secret for signing student session tokens
JWT_SECRET=generate-a-secure-random-64-char-string-for-jwt-signing
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE & LLM GROUNDING
# ------------------------------------------------------------------------------
# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
# Primary grounded engine: uses Gemini's native google_search grounding.
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
# Real model ids only. "gemini-3.7-flash" was never a real model and every
# request 404'd. Current flash model: gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (https://openrouter.ai/keys) — second grounded engine.
# Set OPENROUTER_API_KEY alone and the AI endpoints work without Gemini.
#   perplexity/sonar      → grounded (returns native citations)
#   deepseek/deepseek-chat→ cheap/fast, NOT grounded
# When grounding is required the router picks the grounded model automatically
# and refuses to present an ungrounded answer as live web evidence.
OPENROUTER_API_KEY=sk-or-v1-yourOpenRouterKeyHere
OPENROUTER_PRIMARY_MODEL=perplexity/sonar
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat

# Which engine to use: auto (Gemini, then OpenRouter) | gemini | openrouter
AI_ENGINE=auto

# Tavily Search API (fallback grounding for live cutoff & placement verification)
# From https://tavily.com/
TAVILY_API_KEY=tvly-YourTavilyApiKeyHere

# Hugging Face User Access Token (optional, for local NER model downloads)
HF_TOKEN=hf_YourHuggingFaceTokenHere

# ------------------------------------------------------------------------------
# 5. DATA INGESTION & SCRAPERS
# ------------------------------------------------------------------------------
# Reddit API (from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=TheProjectBot/2.0 (research; contact@theproject.edu.in)

# Data.gov.in API Key (MoSPI PLFS data)
DATA_GOV_IN_API_KEY=your_datagov_api_key

# Adzuna Jobs API (Salary & Job Opening indexing)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# JSearch RapidAPI Key (Job market real-time telemetry)
RAPIDAPI_JSEARCH_KEY=your_rapidapi_key

# ------------------------------------------------------------------------------
# 6. PAYMENTS & MONETIZATION (Section 15 Specification)
# ------------------------------------------------------------------------------
# Razorpay (India domestic cards, UPI, NetBanking)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Stripe (Global cards & international degrees)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 7. EMAIL & COMMUNICATIONS (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=reports@theproject.edu.in

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY & MONITORING
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0
