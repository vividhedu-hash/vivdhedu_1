# ==============================================================================
# The Project — Frontend Production Environment Variables (Next.js 14)
# Copy to .env.local in indialens/ or configure in Vercel / Cloudflare Pages / AWS Amplify
# ==============================================================================

# Public Web Application Base URL
NEXT_PUBLIC_APP_URL=https://theproject.edu.in

# FastAPI Backend URL (Server-to-Server communication in Next.js API route handlers)
# E.g., https://api.theproject.edu.in or http://api:8000 in Docker
FASTAPI_URL=https://api.theproject.edu.in

# Strict Production Flag: Set to 0 to forbid mock/seed fallbacks in production.
# When 0, upstream API failures fail-closed with HTTP 503 instead of serving synthetic data.
ALLOW_MOCK_FALLBACK=0

# Product Analytics (PostHog Cloud)
# Obtain from https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase Auth & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
