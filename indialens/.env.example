# IndiaLens Frontend — Local Environment
# Copy to .env.local (already in .gitignore)

# Server-only FastAPI URL. Required in production. Do not expose to the browser.
FASTAPI_URL=http://localhost:8000

# Local demo: mock fallback is ON by default when NODE_ENV is not production.
# Set to 0 to fail closed locally. Set to 1 to force mock in a production build.
# ALLOW_MOCK_FALLBACK=0

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0-seed
