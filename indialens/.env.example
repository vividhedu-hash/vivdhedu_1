# ==============================================================================
# VividhEdu — Frontend Environment Variables (Next.js 14)
# Copy to .env.local in indialens/ or configure in Vercel project settings.
# ==============================================================================

# Public Web Application Base URL
# The canonical origin, no trailing slash. Drives metadataBase, canonical URLs,
# Open Graph image URLs, sitemap.xml, robots.txt, and the JSON-LD
# Organization/WebSite structured data. Wrong value here = every share link and
# every search result points at the wrong host.
NEXT_PUBLIC_APP_URL=https://indialens.in

# FastAPI Backend URL (Server-to-Server communication in Next.js API route handlers)
# The /api/waitlist proxy calls this to record a signup. It must be reachable
# from the Next.js runtime, not from the browser. E.g. http://api:8000 in Docker.
FASTAPI_URL=https://indialens-api.onrender.com

# Strict Production Flag: Set to 0 to forbid mock/seed fallbacks in production.
# When 0, upstream API failures fail-closed with HTTP 503 instead of serving synthetic data.
# Leave at 0 in production: a signup that reports success without being stored is
# worse than an honest error.
ALLOW_MOCK_FALLBACK=0

# ------------------------------------------------------------------------------
# Waitlist & support
# ------------------------------------------------------------------------------
# Support inbox. Shown on /contact, in the footer, in the privacy and terms
# pages, and as the mailto: fallback of both the waitlist and contact forms.
# Must be an address someone actually reads.
NEXT_PUBLIC_SUPPORT_EMAIL=support@indialens.in

# Privacy / data-deletion request inbox. Kept separate from support so a DPDP
# erasure request does not sit in a general support queue. Server-side only.
NEXT_PRIVACY_EMAIL=privacy@indialens.in

# Operating entity named in the terms, the privacy policy, and /contact. Set to
# the registered legal name once incorporation completes. Until then the pages
# fall back to "operated from India" rather than inventing a company number.
NEXT_PUBLIC_LEGAL_ENTITY=

# Product Analytics (PostHog Cloud)
# Already wired via src/components/PostHogProvider.tsx. This is the vendor the
# waitlist signup event (waitlist_signup) is reported to — do not add a second
# analytics vendor alongside it.
# Obtain from https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase Auth & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Live search on /explore. Sonar searches the web and returns citations.
# From https://openrouter.ai/keys — the model must stay a perplexity/sonar variant.
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=perplexity/sonar
