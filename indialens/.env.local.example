# VividhEdu Frontend — Local Environment
# Copy to .env.local

FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side only. Never prefix NEXT_PUBLIC_. Used when FastAPI is down.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# PostHog Analytics (replace with your project key; do not commit real keys)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
